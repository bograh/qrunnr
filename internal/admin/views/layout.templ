package views

templ Layout(title string, active string) {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="light dark"/>
			<meta name="htmx-config" content='{"defaultSwapStyle":"innerHTML","historyCacheSize":0}'/>
			<title>{ title } · qrunnr</title>
			<link rel="stylesheet" href={ asset("app.css") }/>
			<script src={ asset("vendor/htmx.min.js") } defer></script>
			<script src={ asset("vendor/htmx-ext-sse.js") } defer></script>
		</head>
		<body class="h-full bg-zinc-50 text-zinc-900 antialiased dark:bg-zinc-950 dark:text-zinc-100">
			<div class="flex min-h-full flex-col md:flex-row">
				<aside class="border-b border-zinc-200 bg-zinc-100/70 md:sticky md:top-0 md:h-screen md:w-56 md:shrink-0 md:border-r md:border-b-0 dark:border-zinc-800 dark:bg-zinc-900/60">
					<div class="flex items-center gap-2 px-4 py-3 md:py-5">
						<span class="grid size-7 place-items-center rounded-md bg-zinc-900 font-mono text-xs font-bold text-white dark:bg-white dark:text-zinc-900">TF</span>
						<span class="text-sm font-semibold tracking-tight">qrunnr</span>
						<span class="ml-auto rounded bg-zinc-200 px-1.5 py-0.5 text-[10px] font-medium uppercase tracking-wide text-zinc-600 md:ml-1 dark:bg-zinc-800 dark:text-zinc-400">admin</span>
					</div>
					<nav class="flex gap-1 overflow-x-auto px-3 pb-3 md:flex-col md:pb-0" aria-label="Main">
						<a href="/admin/" class={ navClass(active == "overview") }>Overview</a>
						<a href="/admin/tasks" class={ navClass(active == "tasks") }>Tasks</a>
						<a href="/admin/dlq" class={ navClass(active == "dlq") }>Dead letters</a>
						<a href="/admin/workers" class={ navClass(active == "workers") }>Workers</a>
					</nav>
					<div class="hidden px-4 pt-6 text-xs text-zinc-500 md:block dark:text-zinc-500">
						All times are UTC.
					</div>
				</aside>
				<main class="min-w-0 flex-1 px-4 py-6 md:px-8 md:py-8">
					<div class="mx-auto max-w-7xl space-y-6">
						{ children... }
					</div>
				</main>
			</div>
		</body>
	</html>
}

templ PageHeader(title string, subtitle string) {
	<div class="flex flex-wrap items-end justify-between gap-3">
		<div>
			<h1 class={ pageTitleClass }>{ title }</h1>
			if subtitle != "" {
				<p class={ pageSubClass }>{ subtitle }</p>
			}
		</div>
		{ children... }
	</div>
}

templ LiveBadge() {
	<span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700 ring-1 ring-inset ring-emerald-600/20 dark:bg-emerald-400/10 dark:text-emerald-300 dark:ring-emerald-400/30">
		<span class="relative flex size-1.5">
			<span class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-500 opacity-60"></span>
			<span class="relative inline-flex size-1.5 rounded-full bg-emerald-500"></span>
		</span>
		Live
	</span>
}

templ FlashMessage(f Flash) {
	if f.Message != "" {
		if f.Kind == FlashError {
			<div class={ flashClass(f.Kind) } role="alert">{ f.Message }</div>
		} else {
			<div class={ flashClass(f.Kind) } role="status">{ f.Message }</div>
		}
	}
}

templ StatusBadge(status string) {
	<span class={ statusBadgeClass(modelStatus(status)) }>{ status }</span>
}

templ LiveError() {
	<div class={ flashClass(FlashError) } role="alert">Live data is temporarily unavailable. Retrying…</div>
}

templ ErrorPage(title string, message string) {
	@Layout(title, "") {
		<div class={ cardClass + " p-8 text-center" }>
			<h1 class={ pageTitleClass }>{ title }</h1>
			<p class={ pageSubClass }>{ message }</p>
			<a href="/admin/" class={ btnSecondary + " mt-4" }>Back to overview</a>
		</div>
	}
}
