package views

import (
	"time"

	"qrunnr.dev/internal/model"
)

templ TasksPage(data TaskListData) {
	@Layout("Tasks", "tasks") {
		@PageHeader("Task inspector", "Search tasks by queue, status, worker, or creation time. Dead-lettered tasks live under Dead letters.")
		<form
			id="task-filters"
			action="/admin/tasks"
			method="get"
			hx-get="/admin/tasks"
			hx-target="#task-results"
			hx-push-url="true"
			hx-trigger="change, keyup changed delay:400ms from:input[type=search], submit"
			class={ cardClass + " grid grid-cols-2 items-end gap-3 p-4 md:grid-cols-3 xl:grid-cols-6" }
		>
			<div>
				<label for="f-queue" class={ labelClass }>Queue</label>
				<select id="f-queue" name="queue" class={ inputClass }>
					<option value="">All queues</option>
					for _, name := range data.QueueNames {
						<option value={ name } selected?={ name == data.Form.Queue }>{ name }</option>
					}
				</select>
			</div>
			<div>
				<label for="f-status" class={ labelClass }>Status</label>
				<select id="f-status" name="status" class={ inputClass }>
					<option value="">Any status</option>
					for _, s := range queueStatuses {
						<option value={ string(s) } selected?={ string(s) == data.Form.Status }>{ string(s) }</option>
					}
				</select>
			</div>
			<div>
				<label for="f-worker" class={ labelClass }>Worker ID</label>
				<input id="f-worker" type="search" name="worker" value={ data.Form.Worker } placeholder="worker-1" autocomplete="off" class={ inputClass }/>
			</div>
			<div>
				<label for="f-task" class={ labelClass }>Task ID</label>
				<input id="f-task" type="search" name="task_id" value={ data.Form.TaskID } placeholder="full UUID" autocomplete="off" class={ inputClass + " font-mono" }/>
			</div>
			<div>
				<label for="f-from" class={ labelClass }>Created after (UTC)</label>
				<input id="f-from" type="datetime-local" name="from" value={ data.Form.From } class={ inputClass }/>
			</div>
			<div>
				<label for="f-to" class={ labelClass }>Created before (UTC)</label>
				<input id="f-to" type="datetime-local" name="to" value={ data.Form.To } class={ inputClass }/>
			</div>
			<noscript><button type="submit" class={ btnPrimary }>Filter</button></noscript>
		</form>
		<section id="task-results" class={ cardClass }>
			@TaskResults(data)
		</section>
	}
}

templ TaskResults(data TaskListData) {
	<div class="flex flex-wrap items-center justify-between gap-2 border-b border-zinc-200 px-4 py-3 dark:border-zinc-800">
		<h2 class={ sectionTitle }>
			Results
			if data.Form.Page > 1 {
				<span class="font-normal text-zinc-500 dark:text-zinc-400">· page { itoa(data.Form.Page) }</span>
			}
		</h2>
		if data.Form.active() {
			<a href="/admin/tasks" class="text-xs font-medium text-zinc-600 underline underline-offset-2 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100">Clear filters</a>
		}
	</div>
	if data.Flash.Message != "" {
		<div class="p-4">
			@FlashMessage(data.Flash)
		</div>
	} else if len(data.Tasks) == 0 {
		<p class={ emptyStateClass }>No tasks match these filters.</p>
	} else {
		{{ now := time.Now().UTC() }}
		<div class={ tableWrapClass }>
			<table class={ tableClass }>
				<thead>
					<tr>
						<th scope="col" class={ thClass }>Task</th>
						<th scope="col" class={ thClass }>Queue</th>
						<th scope="col" class={ thClass }>Status</th>
						<th scope="col" class={ thRightClass }>Priority</th>
						<th scope="col" class={ thRightClass }>Attempts</th>
						<th scope="col" class={ thClass }>Worker</th>
						<th scope="col" class={ thClass }>Created</th>
						<th scope="col" class={ thClass }>Scheduled</th>
						<th scope="col" class={ thClass }>Last error</th>
					</tr>
				</thead>
				<tbody class={ tbodyClass }>
					for _, t := range data.Tasks {
						@taskRow(t, now)
					}
				</tbody>
			</table>
		</div>
		@pager(data.Form.Page, data.HasNext, taskListURL(data.Form, data.Form.Page-1), taskListURL(data.Form, data.Form.Page+1), "#task-results")
	}
}

templ taskRow(t model.TaskSummary, now time.Time) {
	<tr class="hover:bg-zinc-50 dark:hover:bg-zinc-800/40">
		<td class={ tdClass }>
			<a href={ templ.URL(taskURL(t.ID)) } class={ monoLinkClass } title={ t.ID }>{ shortID(t.ID) }</a>
		</td>
		<td class={ tdClass }>{ t.QueueName }</td>
		<td class={ tdClass }>
			@StatusBadge(string(t.Status))
		</td>
		<td class={ tdRightClass }>{ itoa(t.Priority) }</td>
		<td class={ tdRightClass }>{ itoa(t.Attempts) }</td>
		<td class={ tdClass }>
			if t.ClaimedBy != nil {
				<a href={ templ.URL(taskListURL(TaskFilterForm{Worker: *t.ClaimedBy}, 1)) } class="font-mono text-xs hover:underline">{ *t.ClaimedBy }</a>
			} else {
				<span class={ mutedClass }>—</span>
			}
		</td>
		<td class={ tdClass } title={ fmtTime(t.CreatedAt) }>{ relative(t.CreatedAt, now) }</td>
		<td class={ tdClass } title={ fmtTime(t.ScheduledAt) }>
			if t.ScheduledAt.After(now) {
				<span class="text-amber-700 dark:text-amber-300">{ relative(t.ScheduledAt, now) }</span>
			} else {
				{ fmtTime(t.ScheduledAt) }
			}
		</td>
		<td class={ tdClass + " max-w-xs truncate" } title={ deref(t.LastError) }>
			if t.LastError != nil {
				<span class="text-red-700 dark:text-red-300">{ truncate(*t.LastError, 60) }</span>
			} else {
				<span class={ mutedClass }>—</span>
			}
		</td>
	</tr>
}

templ pager(page int, hasNext bool, prevURL string, nextURL string, target string) {
	if page > 1 || hasNext {
		<nav class="flex items-center justify-between border-t border-zinc-200 px-4 py-3 dark:border-zinc-800" aria-label="Pagination">
			if page > 1 {
				<a href={ templ.URL(prevURL) } hx-get={ prevURL } hx-target={ target } hx-push-url="true" class={ btnSecondary }>← Previous</a>
			} else {
				<span></span>
			}
			if hasNext {
				<a href={ templ.URL(nextURL) } hx-get={ nextURL } hx-target={ target } hx-push-url="true" class={ btnSecondary }>Next →</a>
			}
		</nav>
	}
}

templ TaskDetailPage(data TaskDetailData) {
	@Layout("Task "+shortID(data.TaskID), "tasks") {
		<a href="/admin/tasks" class="text-sm text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100">← Tasks</a>
		<div id="task-detail" class="space-y-6">
			@TaskDetailBody(data)
		</div>
	}
}

templ detailField(label string, value string) {
	<div>
		<dt class="text-xs font-medium text-zinc-500 dark:text-zinc-400">{ label }</dt>
		<dd class="mt-0.5 text-sm text-zinc-900 dark:text-zinc-100">{ value }</dd>
	</div>
}

templ jsonBlock(title string, body string, empty string) {
	<section class={ cardClass }>
		<h2 class={ sectionTitle + " border-b border-zinc-200 px-4 py-3 dark:border-zinc-800" }>{ title }</h2>
		if body == "" {
			<p class="px-4 py-3 text-sm text-zinc-500 dark:text-zinc-400">{ empty }</p>
		} else {
			<pre class="max-h-96 overflow-auto px-4 py-3 font-mono text-xs leading-relaxed text-zinc-800 dark:text-zinc-200">{ body }</pre>
		}
	</section>
}

templ TaskDetailBody(data TaskDetailData) {
	{{ now := time.Now().UTC() }}
	<div class="flex flex-wrap items-center gap-3">
		<h1 class={ pageTitleClass }>Task <span class="font-mono text-base font-medium">{ data.TaskID }</span></h1>
		if data.Task != nil {
			@StatusBadge(string(data.Task.Status))
		} else if data.Dead != nil {
			@StatusBadge("dead")
		}
	</div>
	@FlashMessage(data.Flash)
	if data.Task != nil {
		{{ t := data.Task }}
		<section class={ cardClass + " p-4" }>
			<dl class="grid grid-cols-2 gap-x-6 gap-y-4 sm:grid-cols-3 lg:grid-cols-4">
				<div>
					<dt class="text-xs font-medium text-zinc-500 dark:text-zinc-400">Queue</dt>
					<dd class="mt-0.5 text-sm"><a href={ templ.URL(queueTasksURL(t.QueueName)) } class={ linkClass }>{ t.QueueName }</a></dd>
				</div>
				@detailField("Priority", itoa(t.Priority))
				@detailField("Attempts", itoa(t.Attempts))
				@detailField("Worker", orDash(deref(t.ClaimedBy)))
				@detailField("Created", fmtTime(t.CreatedAt))
				@detailField("Scheduled", fmtTime(t.ScheduledAt)+suffix(relative(t.ScheduledAt, now)))
				@detailField("Claimed", fmtTimePtr(t.ClaimedAt))
				@detailField("Last heartbeat", fmtTimePtr(t.HeartbeatAt)+suffix(relativePtr(t.HeartbeatAt, now)))
				@detailField("Completed", fmtTimePtr(t.CompletedAt))
			</dl>
			if t.Status == model.TaskStatusPending {
				<div class="mt-4 border-t border-zinc-200 pt-4 dark:border-zinc-800">
					<button
						type="button"
						hx-post={ "/admin/tasks/" + t.ID + "/cancel" }
						hx-vals={ hxVals("queue", t.QueueName) }
						hx-target="#task-detail"
						hx-confirm="Cancel this task? It will never be dispatched."
						class={ btnDanger }
					>Cancel task</button>
				</div>
			}
		</section>
		if t.LastError != nil {
			<section class="rounded-lg border border-red-200 bg-red-50 p-4 dark:border-red-400/30 dark:bg-red-400/10">
				<h2 class="text-xs font-medium uppercase tracking-wide text-red-700 dark:text-red-300">Last error</h2>
				<pre class="mt-1 whitespace-pre-wrap font-mono text-sm text-red-900 dark:text-red-100">{ *t.LastError }</pre>
			</section>
		}
		<div class="grid gap-6 lg:grid-cols-2">
			@jsonBlock("Payload", prettyJSON(t.Payload), "Empty payload.")
			@jsonBlock("Result", prettyJSON(t.Result), "No result recorded.")
		</div>
	} else if data.Dead != nil {
		{{ d := data.Dead }}
		<section class={ cardClass + " p-4" }>
			<p class="mb-4 text-sm text-zinc-600 dark:text-zinc-400">This task exhausted its retries and is in the dead-letter queue.</p>
			<dl class="grid grid-cols-2 gap-x-6 gap-y-4 sm:grid-cols-3 lg:grid-cols-4">
				<div>
					<dt class="text-xs font-medium text-zinc-500 dark:text-zinc-400">Queue</dt>
					<dd class="mt-0.5 text-sm"><a href={ templ.URL(queueDLQURL(d.QueueName)) } class={ linkClass }>{ d.QueueName }</a></dd>
				</div>
				@detailField("Attempts", itoa(d.Attempts))
				@detailField("Died", fmtTime(d.DiedAt)+suffix(relative(d.DiedAt, now)))
				@detailField("Replays", itoa(d.ReplayCount))
				@detailField("Last replayed", fmtTimePtr(d.ReplayedAt))
			</dl>
			<div class="mt-4 flex gap-2 border-t border-zinc-200 pt-4 dark:border-zinc-800">
				<button type="button" hx-post="/admin/dlq/replay" hx-vals={ hxVals("selected", selectedValue(d.QueueName, d.ID)) } hx-target="#task-detail" class={ btnPrimary }>Replay</button>
				<button type="button" hx-post="/admin/dlq/discard" hx-vals={ hxVals("selected", selectedValue(d.QueueName, d.ID)) } hx-target="#task-detail" hx-confirm="Permanently discard this dead-letter task?" class={ btnDanger }>Discard</button>
			</div>
		</section>
		<section class="rounded-lg border border-red-200 bg-red-50 p-4 dark:border-red-400/30 dark:bg-red-400/10">
			<h2 class="text-xs font-medium uppercase tracking-wide text-red-700 dark:text-red-300">Last error</h2>
			<pre class="mt-1 whitespace-pre-wrap font-mono text-sm text-red-900 dark:text-red-100">{ d.LastError }</pre>
		</section>
		@jsonBlock("Payload", prettyJSON(d.Payload), "Empty payload.")
	} else if len(data.Events) > 0 {
		<div class={ cardClass + " px-4 py-3 text-sm text-zinc-700 dark:text-zinc-300" }>
			This task is no longer stored (it was discarded from the dead-letter queue or its queue was deleted). Its history is shown below.
		</div>
	} else {
		<div class={ cardClass + " p-8 text-center" }>
			<p class="text-sm text-zinc-600 dark:text-zinc-400">No task with this ID exists.</p>
		</div>
	}
	if len(data.Events) > 0 {
		@taskTimeline(data, now)
	}
}

templ taskTimeline(data TaskDetailData, now time.Time) {
	{{ hbs, hbTotal := data.heartbeats(200) }}
	<div class="grid gap-6 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
		<section class={ cardClass }>
			<h2 class={ sectionTitle + " border-b border-zinc-200 px-4 py-3 dark:border-zinc-800" }>Status history</h2>
			<ol class="m-4 space-y-4 border-l border-zinc-200 dark:border-zinc-700">
				for _, e := range data.transitions() {
					<li class="relative pl-5">
						<span class={ timelineDotClass(e) } aria-hidden="true"></span>
						<div class="flex flex-wrap items-baseline justify-between gap-x-3">
							<p class="text-sm font-medium text-zinc-900 dark:text-zinc-100">{ eventTitle(e) }</p>
							<time datetime={ isoTime(e.CreatedAt) } title={ relative(e.CreatedAt, now) } class="font-mono text-xs text-zinc-500 dark:text-zinc-400">{ fmtTime(e.CreatedAt) }</time>
						</div>
						if e.WorkerID != "" {
							<p class="text-xs text-zinc-500 dark:text-zinc-400">worker <span class="font-mono">{ e.WorkerID }</span></p>
						}
						if id := linkedTaskID(e); id != "" {
							<p class="text-xs text-zinc-600 dark:text-zinc-400">
								{ e.Message[:len(e.Message)-len(id)] }
								<a href={ templ.URL(taskURL(id)) } class={ monoLinkClass }>{ shortID(id) }</a>
							</p>
						} else if e.Message != "" {
							<p class="mt-0.5 break-words font-mono text-xs text-red-700 dark:text-red-300">{ e.Message }</p>
						}
					</li>
				}
			</ol>
		</section>
		<section class={ cardClass }>
			<h2 class={ sectionTitle + " border-b border-zinc-200 px-4 py-3 dark:border-zinc-800" }>
				Heartbeats <span class="font-normal text-zinc-500 dark:text-zinc-400">({ itoa(hbTotal) })</span>
			</h2>
			if hbTotal == 0 {
				<p class="px-4 py-3 text-sm text-zinc-500 dark:text-zinc-400">No heartbeats recorded.</p>
			} else {
				<ul class="max-h-80 divide-y divide-zinc-100 overflow-y-auto dark:divide-zinc-800">
					for _, e := range hbs {
						<li class="flex items-center justify-between gap-3 px-4 py-1.5 text-xs">
							<span class="font-mono text-zinc-700 dark:text-zinc-300">{ fmtTime(e.CreatedAt) }</span>
							<span class="font-mono text-zinc-500 dark:text-zinc-400">{ e.WorkerID }</span>
						</li>
					}
				</ul>
				if hbTotal > len(hbs) {
					<p class="border-t border-zinc-200 px-4 py-2 text-xs text-zinc-500 dark:border-zinc-800 dark:text-zinc-400">Showing the latest { itoa(len(hbs)) }.</p>
				}
			}
		</section>
	</div>
}
