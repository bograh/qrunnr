package views

import "qrunnr.dev/internal/model"

templ OverviewPage(data OverviewData, queues []model.Queue, flash Flash) {
	@Layout("Overview", "overview") {
		@PageHeader("Overview", "Queue health across the cluster. Throughput and error rate cover the last minute.") {
			@LiveBadge()
		}
		<div hx-ext="sse" sse-connect="/admin/events?view=overview">
			<div id="overview-live" sse-swap="overview" class="space-y-6">
				@OverviewLive(data)
			</div>
		</div>
		@ManageQueues(queues, flash)
	}
}

templ statCard(label string, value string, detail string, tone string) {
	<div class={ cardClass + " px-4 py-3" }>
		<dt class="text-xs font-medium text-zinc-500 dark:text-zinc-400">{ label }</dt>
		<dd class={ "mt-1 text-2xl font-semibold tabular-nums tracking-tight " + tone }>{ value }</dd>
		if detail != "" {
			<dd class="mt-0.5 text-xs text-zinc-500 dark:text-zinc-400">{ detail }</dd>
		}
	</div>
}

templ OverviewLive(data OverviewData) {
	{{ t := data.totals() }}
	<dl class="grid grid-cols-2 gap-3 lg:grid-cols-5">
		@statCard("Queued", itoa(t.Depth), "pending + awaiting retry", "text-zinc-900 dark:text-zinc-50")
		@statCard("Executing", itoa(t.Executing), "held by workers", "text-violet-700 dark:text-violet-300")
		@statCard("Throughput", throughput(t.DoneLastMinute)+"/s", itoa(t.DoneLastMinute)+" done in the last minute", "text-emerald-700 dark:text-emerald-300")
		if t.DLQ > 0 {
			@statCard("Dead letters", itoa(t.DLQ), errorRateDetail(t.DoneLastMinute, t.FailedLastMinute), "text-red-600 dark:text-red-400")
		} else {
			@statCard("Dead letters", "0", errorRateDetail(t.DoneLastMinute, t.FailedLastMinute), "text-zinc-900 dark:text-zinc-50")
		}
		if t.StaleWorkers > 0 {
			@statCard("Workers", itoa(t.ActiveWorkers), itoa(t.StaleWorkers)+" stale", "text-amber-600 dark:text-amber-400")
		} else {
			@statCard("Workers", itoa(t.ActiveWorkers), "seen in the last 60s", "text-zinc-900 dark:text-zinc-50")
		}
	</dl>
	<section class={ cardClass }>
		<div class="flex items-center justify-between border-b border-zinc-200 px-4 py-3 dark:border-zinc-800">
			<h2 class={ sectionTitle }>Queues</h2>
			<span class="text-xs text-zinc-500 dark:text-zinc-400">
				Updated <time datetime={ isoTime(data.GeneratedAt) }>{ data.GeneratedAt.Format("15:04:05") }</time>
			</span>
		</div>
		if len(data.Queues) == 0 {
			<p class={ emptyStateClass }>No queues yet. Create one below or with <code class="font-mono text-xs">POST /queues</code>.</p>
		} else {
			<div class={ tableWrapClass }>
				<table class={ tableClass }>
					<thead>
						<tr>
							<th scope="col" class={ thClass }>Queue</th>
							<th scope="col" class={ thRightClass }>Depth</th>
							<th scope="col" class={ thRightClass }>Executing</th>
							<th scope="col" class={ thRightClass }>Tasks/sec</th>
							<th scope="col" class={ thRightClass }>Error rate</th>
							<th scope="col" class={ thRightClass }>Oldest pending</th>
							<th scope="col" class={ thRightClass }>DLQ</th>
							<th scope="col" class={ thRightClass }>Rate limit</th>
						</tr>
					</thead>
					<tbody class={ tbodyClass }>
						for _, q := range data.Queues {
							<tr class="hover:bg-zinc-50 dark:hover:bg-zinc-800/40">
								<td class={ tdClass }>
									<a href={ templ.URL(queueTasksURL(q.Queue.Name)) } class={ linkClass }>{ q.Queue.Name }</a>
								</td>
								<td class={ tdRightClass }>{ itoa(q.Stats.Depth) }</td>
								<td class={ tdRightClass }>{ itoa(q.Stats.ExecutingCount) }</td>
								<td class={ tdRightClass }>{ throughput(q.Stats.DoneLastMinute) }</td>
								<td class={ tdRightClass }>
									<span class={ errorRateClass(q.Stats.DoneLastMinute, q.Stats.FailedLastMinute) }>
										{ errorRate(q.Stats.DoneLastMinute, q.Stats.FailedLastMinute) }
									</span>
								</td>
								<td class={ tdRightClass }>{ ageSeconds(q.Stats.OldestPendingAgeSeconds) }</td>
								<td class={ tdRightClass }>
									if q.Stats.DLQDepth > 0 {
										<a href={ templ.URL(queueDLQURL(q.Queue.Name)) } class="font-semibold text-red-600 underline decoration-red-300 underline-offset-2 dark:text-red-400">{ itoa(q.Stats.DLQDepth) }</a>
									} else {
										<span class={ mutedClass }>0</span>
									}
								</td>
								<td class={ tdRightClass }>{ rateLimitLabel(q.Queue.RateLimit) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</section>
}

templ ManageQueues(queues []model.Queue, flash Flash) {
	<section id="manage-queues" class={ cardClass }>
		<div class="border-b border-zinc-200 px-4 py-3 dark:border-zinc-800">
			<h2 class={ sectionTitle }>Manage queues</h2>
			<p class="mt-0.5 text-xs text-zinc-500 dark:text-zinc-400">Rate limit changes apply to the next dispatch.</p>
		</div>
		<div class="space-y-4 p-4">
			@FlashMessage(flash)
			<form
				hx-post="/admin/queues"
				hx-target="#manage-queues"
				hx-swap="outerHTML"
				class="grid grid-cols-1 items-end gap-3 sm:grid-cols-[minmax(0,2fr)_minmax(0,1fr)_minmax(0,1fr)_auto]"
			>
				<div>
					<label for="queue-name" class={ labelClass }>Name</label>
					<input id="queue-name" name="name" required maxlength="64" pattern="[A-Za-z0-9_\-]{1,64}" placeholder="email_jobs" autocomplete="off" class={ inputClass }/>
				</div>
				<div>
					<label for="queue-max-retries" class={ labelClass }>Max retries</label>
					<input id="queue-max-retries" name="max_retries" type="number" min="0" max="25" value="3" required class={ inputClass }/>
				</div>
				<div>
					<label for="queue-rate-limit" class={ labelClass }>Rate limit (tasks/sec)</label>
					<input id="queue-rate-limit" name="rate_limit" type="number" min="1" placeholder="unlimited" class={ inputClass }/>
				</div>
				<button type="submit" class={ btnPrimary }>Create queue</button>
			</form>
			if len(queues) > 0 {
				<div class={ tableWrapClass + " -mx-4" }>
					<table class={ tableClass }>
						<thead>
							<tr>
								<th scope="col" class={ thClass + " pl-4" }>Queue</th>
								<th scope="col" class={ thRightClass }>Max retries</th>
								<th scope="col" class={ thClass }>Rate limit (tasks/sec)</th>
								<th scope="col" class={ thClass }>Created</th>
								<th scope="col" class={ thRightClass + " pr-4" }><span class="sr-only">Actions</span></th>
							</tr>
						</thead>
						<tbody class={ tbodyClass }>
							for _, q := range queues {
								<tr>
									<td class={ tdClass + " pl-4 font-medium text-zinc-900 dark:text-zinc-100" }>{ q.Name }</td>
									<td class={ tdRightClass }>{ itoa(q.MaxRetries) }</td>
									<td class={ tdClass }>
										<form hx-post={ "/admin/queues/" + q.Name + "/rate-limit" } hx-target="#manage-queues" hx-swap="outerHTML" class="flex items-center gap-2">
											<label class="sr-only" for={ "rate-" + q.Name }>Rate limit for { q.Name }</label>
											<input id={ "rate-" + q.Name } name="rate_limit" type="number" min="1" value={ rateLimitValue(q.RateLimit) } placeholder="unlimited" class={ compactInputClass }/>
											<button type="submit" class={ btnSmall }>Save</button>
										</form>
									</td>
									<td class={ tdClass }>{ fmtTime(q.CreatedAt) }</td>
									<td class={ tdRightClass + " pr-4" }>
										<button
											type="button"
											hx-delete={ "/admin/queues/" + q.Name }
											hx-target="#manage-queues"
											hx-swap="outerHTML"
											hx-confirm={ "Delete queue " + q.Name + "? Finished tasks and dead letters in it are removed too." }
											class={ btnSmallDanger }
										>Delete</button>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	</section>
}
